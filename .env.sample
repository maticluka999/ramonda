# Loaded by vitest (see vitest.config.ts). Only the e2e suite reads these, and
# without RAMONDA_E2E_GH_TOKEN it skips itself entirely.

# Required. PAT with repo + project + delete_repo — the suite creates a
# throwaway repo and Project per run and deletes both on success.
RAMONDA_E2E_GH_TOKEN=
# Required. The Github login that owns that repo and Project.
RAMONDA_E2E_GH_USER=

# Optional. Path to the claude binary the session should run (default: claude).
RAMONDA_E2E_CLAUDE_BIN=
# Optional. Model for the session (default: claude-sonnet-5).
RAMONDA_E2E_MODEL=
